{
  "manifest_version": 3,
  "name": "Bobbinly",
  "version": "0.1.0",
  "description": "Copy a full email thread in one click, ready for your AI.",
  "permissions": ["storage"],
  "options_page": "options.html",
  "action": {
    "default_title": "Bobbinly"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"]
    }
  ]
}